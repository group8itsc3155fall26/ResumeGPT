// Prisma schema for ResumeGPT. Mirrors the Project / Resume types in src/App.tsx.
// SQLite keeps the Sprint 2 deliverable runnable with no database server to install.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  // Default keeps the column addable on databases that already have users;
  // the API still requires a real name when a profile is created.
  name           String    @default("")
  major          String    @default("Computer Science")
  // Defaults to the sample university so seeded and demo profiles stay complete.
  college        String    @default("UNC Charlotte")
  // "Freshman" | "Sophomore" | "Junior" | "Senior"; validated in src/server/users.ts.
  classStanding  String    @default("Freshman")
  graduationYear Int?
  createdAt      DateTime  @default(now())
  projects       Project[]
  resumes        Resume[]
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  course      String
  semester    String
  description String
  // SQLite has no array column, so skills is a JSON-encoded string[].
  skills      String   @default("[]")
  // One-line outcome ("cut lookup to O((V+E) log V)") used by the resume bullet generator.
  highlight   String?
  // "Canvas" | "Personal", matching Project["source"] in src/App.tsx.
  source      String   @default("Personal")
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Resume {
  id        Int      @id @default(autoincrement())
  title     String
  // Display string ("October 4, 2026") to match Resume["date"] in src/App.tsx.
  date      String
  // JSON-encoded ResumeBullet[]: { id, text, source, projectId }.
  // Each bullet keeps its course attribution so every claim stays traceable.
  bullets   String   @default("[]")
  // JSON-encoded ResumeContent from the Gemini draft (skills + projects sections);
  // null for resumes that were not AI-generated.
  content   String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([userId])
}
