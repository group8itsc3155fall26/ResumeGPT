@startuml
' ResumeGPT — user story: "save a resume generated from coursework"
' Mirrors src/App.tsx -> server/index.ts -> src/server/resumes.ts -> Prisma
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber

title Save a resume with source-traceable bullets

actor Student as U
participant "Resume UI\n(React, src/App.tsx)" as UI
participant "Express API\n(POST /api/resumes)" as API
participant "resumes.ts\n(validation + bullets)" as SVC
participant "Prisma\n(data access)" as ORM
database "SQLite\n(prisma/dev.db)" as SQL

U -> UI : enter target role, choose skills
U -> UI : click "Generate resume"
activate UI
UI -> UI : buildDraft(projects, skills, role)\nrank projects, draft one bullet each
UI --> U : review dialog with\nsource badge per bullet
U -> UI : edit bullet text, then "Approve & save"

UI -> API : POST /api/resumes\nx-student-id: 7\n{ title, bullets: [{id, text, source, projectId}] }
activate API

API -> API : currentStudent(req)
alt header missing or unknown (401)
  API --> UI : 401 { error }
  UI --> U : "Sign in with a student profile to continue."
else session valid
  API -> SVC : createResume({ userId, title, bullets })
  activate SVC

  SVC -> SVC : parseBullets()\nreject non-array, empty text

  alt invalid input (400)
    SVC --> API : ValidationError
    API --> UI : 400 { error }
    UI --> U : inline error; dialog stays open
  else valid
    SVC -> ORM : resume.create({ data })
    activate ORM
    ORM -> SQL : INSERT INTO Resume\n(userId, title, date, bullets)
    activate SQL
    SQL --> ORM : new row (id, createdAt, updatedAt)
    deactivate SQL
    ORM --> SVC : Resume record
    deactivate ORM
    SVC --> API : { id, title, date, bullets }
    API --> UI : 201 { resume }
    UI -> UI : prepend to resume library
    UI --> U : "Resume saved to your library."
  end

  deactivate SVC
end

deactivate API
deactivate UI

note over ORM, SQL
  bullets is JSON text. The source label inside
  each bullet keeps the resume claim traceable
  to its course assignment after the row is
  reloaded, including after a server restart.
end note

@enduml
