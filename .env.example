# SQLite file lives in prisma/ (path is relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"
# Port for the Express data API (server/index.ts).
API_PORT=3001
# Google Gemini API key for resume generation (https://aistudio.google.com/apikey).
# Put the real key in your local .env only; never commit it. Read by the API server, never sent to the browser.
GEMINI_API_KEY=""
# Optional: override the Gemini model (defaults to gemini-3.8-flash).
# GEMINI_MODEL="gemini-3.8-flash"
# Optional: model to retry with when the main one is overloaded (defaults to gemini-3.5-flash-lite).
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
